SECRET_KEY=replace-this-with-a-secure-django-secret-key
DEBUG=True
USE_MYSQL=False
MYSQL_DATABASE=pudpredict_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Email verification
# Leave console backend during local development to print verification links in VS Code terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PUDPredict <no-reply@pudpredict.local>
EMAIL_VERIFICATION_MAX_AGE=86400

# Production deployment
ALLOWED_HOSTS=127.0.0.1,localhost,your-app-name.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com
DATABASE_URL=
SECURE_SSL_REDIRECT=False
